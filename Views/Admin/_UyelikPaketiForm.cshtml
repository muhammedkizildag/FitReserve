@model UyelikPaketiFormViewModel

<form method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Ad" class="form-label">Paket Adi</label>
            <input asp-for="Ad" class="form-control" />
            <span asp-validation-for="Ad" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SureGun" class="form-label">Sure (Gun)</label>
            <input asp-for="SureGun" class="form-control" />
            <span asp-validation-for="SureGun" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Fiyat" class="form-label">Fiyat</label>
            <input asp-for="Fiyat" class="form-control" />
            <span asp-validation-for="Fiyat" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Aciklama" class="form-label">Aciklama</label>
            <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="form-islemleri">
        <button class="btn btn-primary" type="submit">Kaydet</button>
        <a class="btn btn-outline-secondary" asp-action="UyelikPaketleri">Vazgec</a>
    </div>
</form>
