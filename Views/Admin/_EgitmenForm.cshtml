@model EgitmenFormViewModel

<form method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="AdSoyad" class="form-label">Ad Soyad</label>
            <input asp-for="AdSoyad" class="form-control" />
            <span asp-validation-for="AdSoyad" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UzmanlikAlani" class="form-label">Uzmanlik Alani</label>
            <input asp-for="UzmanlikAlani" class="form-control" />
            <span asp-validation-for="UzmanlikAlani" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Eposta" class="form-label">Eposta</label>
            <input asp-for="Eposta" class="form-control" />
            <span asp-validation-for="Eposta" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Telefon" class="form-label">Telefon</label>
            <input asp-for="Telefon" class="form-control" />
        </div>
    </div>

    <div class="form-islemleri">
        <button class="btn btn-primary" type="submit">Kaydet</button>
        <a class="btn btn-outline-secondary" asp-action="Egitmenler">Vazgec</a>
    </div>
</form>
