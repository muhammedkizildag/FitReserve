@model List<Bildirim>
@{
    Layout = "_EgitmenLayout";
    ViewData["Title"] = "Bildirimlerim";
}

<div class="card-glass">
    <h3>🔔 Tüm Bildirimleriniz</h3>
    <p class="text-muted">Buradan size gönderilen son bildirimleri görüntüleyebilirsiniz. Okunmamış olanlar zümrüt yeşili kenarlık ile vurgulanmıştır.</p>

    @if (Model.Any())
    {
        <div class="bildirim-listesi">
            @foreach (var bildirim in Model)
            {
                <div class="bildirim-karti @(!bildirim.OkunduMu ? "okunmadi" : "")">
                    <div class="ikon-yeri">💬</div>
                    <div class="detay">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="m-0">@bildirim.Baslik</h4>
                            @if (!bildirim.OkunduMu)
                            {
                                <span class="badge bg-success" style="font-size: 10px;">Yeni</span>
                            }
                        </div>
                        <p class="mb-2 text-light">@bildirim.Mesaj</p>
                        <span class="tarih">🕒 Gönderim Tarihi: @bildirim.GonderimTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <span class="display-6 d-block mb-3">📭</span>
            <p class="text-muted mb-0">Henüz herhangi bir bildiriminiz bulunmamaktadır.</p>
        </div>
    }
</div>
