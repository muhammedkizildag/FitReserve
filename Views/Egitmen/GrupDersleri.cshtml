@model EgitmenGrupDersleriViewModel
@{
    Layout = "_EgitmenLayout";
    ViewData["Title"] = "Grup Derslerim";
}

<div class="card-glass">
    <h3>🗓️ Atandığınız Grup Dersleri</h3>
    <p class="text-muted">Aşağıda sorumluluğunuzda olan tüm geçmiş ve gelecek grup dersleri listelenmektedir.</p>

    @if (Model.Dersler.Any())
    {
        <div class="ders-listesi">
            @foreach (var ders in Model.Dersler)
            {
                var gecmisMi = ders.BaslangicZamani < DateTime.Now;
                <div class="ders-karti @(ders.IptalMi ? "iptal" : "")">
                    <div class="sol-bolum">
                        <div class="d-flex align-items-center gap-2">
                            <h4>@ders.DersAdi</h4>
                            @if (ders.IptalMi)
                            {
                                <span class="badge bg-danger">İptal Edildi</span>
                            }
                            else if (gecmisMi)
                            {
                                <span class="badge bg-secondary">Tamamlandı</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                        </div>
                        <div class="bilgiler mt-1">
                            <span>📅 Tarih: @ders.BaslangicZamani.ToString("dd.MM.yyyy, dddd")</span>
                            <span>🕒 Saat: @ders.BaslangicZamani.ToString("HH:mm")</span>
                            <span>⏳ Süre: @ders.SureDakika dk</span>
                        </div>
                    </div>
                    <div class="sag-bolum text-end">
                        <div class="mb-2">
                            <span class="kontenjan-metni">Doluluk: @ders.KatilimciSayisi / @ders.Kapasite</span>
                            <div class="kontenjan-bar mt-1">
                                <div class="kontenjan-doluluk" style="width: @((double)ders.KatilimciSayisi / ders.Kapasite * 100)%"></div>
                            </div>
                        </div>

                        @if (!ders.IptalMi)
                        {
                            <button type="button" class="btn-custom" data-bs-toggle="modal" data-bs-target="#modalKatilimcilar-@ders.Id">
                                👥 Katılımcı Listesi (@ders.KatilimciSayisi)
                            </button>
                        }
                    </div>
                </div>

                <!-- Katılımcı Listesi Modalı -->
                @if (!ders.IptalMi)
                {
                    var dersRezervasyonlari = Model.Rezervasyonlar.Where(r => r.GrupDersiId == ders.Id).ToList();
                    var katilanUyeIdleri = dersRezervasyonlari.Select(r => r.UyeId).ToList();
                    var katilanUyeler = Model.Uyeler.Where(u => katilanUyeIdleri.Contains(u.Id)).ToList();

                    <div class="modal fade" id="modalKatilimcilar-@ders.Id" tabindex="-1" aria-labelledby="modalLabel-@ders.Id" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content bg-dark border-secondary text-light" style="background-color: #0b0f19 !important; border: 1px solid rgba(255,255,255,0.08) !important;">
                                <div class="modal-header border-bottom border-secondary">
                                    <h5 class="modal-title" id="modalLabel-@ders.Id">👥 @ders.DersAdi - Katılımcı Listesi</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                                </div>
                                <div class="modal-body">
                                    @if (katilanUyeler.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-dark table-hover table-glass">
                                                <thead>
                                                    <tr>
                                                        <th>Ad Soyad</th>
                                                        <th>E-posta</th>
                                                        <th>Telefon</th>
                                                        <th>Kayıt Tarihi</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var uye in katilanUyeler)
                                                    {
                                                        var rez = dersRezervasyonlari.FirstOrDefault(r => r.UyeId == uye.Id);
                                                        <tr>
                                                            <td>@uye.AdSoyad</td>
                                                            <td>@uye.Eposta</td>
                                                            <td>@uye.Telefon</td>
                                                            <td>@(rez?.RezervasyonTarihi.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4">
                                            <p class="text-muted mb-0">Bu derse henüz kayıtlı katılımcı bulunmamaktadır.</p>
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer border-top border-secondary">
                                    <button type="button" class="btn-custom-secondary" data-bs-dismiss="modal">Kapat</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <p class="text-muted">Atandığınız herhangi bir grup dersi bulunmamaktadır.</p>
    }
</div>
