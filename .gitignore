## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/lib/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# Build Compliance Linker
Anticorruption.Check.xml

# OpenCover
[Dd]ebug_Internal_Reporting/
[Rr]elease_Internal_Reporting/
[Cc]overage.xml
[Cc]overage.json
[Cc]overage.info

# Visual Studio Profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Code settings
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio Code Server
.vscode-server/

# Logic App explorer log
VisualStudioCodeExtension.log

# Azure Functions local settings
local.settings.json

# Visual Studio cache files
# An exclusivity flag in a sub-directory will prevent its contents from being ignored.
*.Cache
!*.Targets

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.user
*.sqlsettings
*.sqlite
*.db

# Tables and data
# Data/*.json

# UserSecrets
[Aa]ppsettings.[Dd]evelopment.json

# Bootstrapper for VS Code
.deploy/

# Node usage
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# JetBrains Rider
.idea/
*.sln.iml

# MacOS
.DS_Store
WebProgProjeKonular.pdf
